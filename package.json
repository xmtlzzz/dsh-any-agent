{
  "name": "dsh-any-agent",
  "version": "0.3.2",
  "description": "Drive DeepSeek Harness (DSH) as a long-lived coding agent from any MCP client — Claude Code, Claude Desktop, Codex, Cursor, Windsurf, Zed, Gemini CLI, opencode, VS Code. Resume-aware, interruptible, approval-capable, and it only ever touches the one config entry it owns.",
  "type": "module",
  "license": "MIT",
  "author": "xmtlz (https://github.com/xmtlzzz)",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "agent",
    "coding-agent",
    "subagent",
    "claude-code",
    "codex",
    "acp",
    "agent-client-protocol",
    "ai",
    "llm",
    "orchestration"
  ],
  "bin": {
    "dsh-any-agent": "bin/dsh-any-agent.mjs",
    "dsh-any-agent-setup": "bin/setup.mjs",
    "dsh-any-agent-restore": "bin/restore.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "profile-example/",
    "README.md",
    "README.zh.md",
    "USAGE-NOTES.en.md",
    "USAGE-NOTES.md",
    "USAGE-MIGRATION.md",
    "LICENSE",
    "DESIGN.md",
    "scripts/"
  ],
  "scripts": {
    "start": "node ./bin/dsh-any-agent.mjs",
    "setup": "node ./bin/setup.mjs",
    "test": "node ./test/run.mjs",
    "test:smoke": "node ./test/smoke.mjs",
    "test:guards": "node ./test/guards.mjs",
    "test:prune": "node ./test/prune.mjs",
    "commit": "node ./scripts/commit.mjs"
  },
  "engines": {
    "node": ">=22.15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xmtlzzz/dsh-any-agent.git"
  },
  "homepage": "https://github.com/xmtlzzz/dsh-any-agent#readme",
  "bugs": {
    "url": "https://github.com/xmtlzzz/dsh-any-agent/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
